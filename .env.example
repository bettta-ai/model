# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables for the deployed site.
#
# Never commit real values. This repository is public.

# --- Supabase (required) ---------------------------------------------------
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The SERVICE ROLE key, not the anon key. Server-side only — it bypasses row
# level security and must never reach the browser. Mark it as a Sensitive
# variable in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to "submissions".
SUPABASE_STORAGE_BUCKET=submissions

# --- Admin access (required to read submissions in the browser) ------------
# A long random string. Generate one with: openssl rand -hex 32
# It gates /admin and is what the notification email's link carries.
ADMIN_TOKEN=

# --- Notification email (optional but recommended) -------------------------
# Where the "new submission" alert goes.
NOTIFY_EMAIL=hello@bettta.ai
# https://resend.com → API Keys. Mark as Sensitive in Vercel.
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
NOTIFY_FROM=SCOUT <scout@bettta.ai>

# --- Links -----------------------------------------------------------------
# Used to build the "view this entry" link in the notification email.
# Falls back to the Vercel-provided deployment URL when unset.
APP_BASE_URL=https://model.bettta.ai
