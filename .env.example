# Only variable the app reads. Set it in Vercel -> Settings -> Environment
# Variables. Leave it unset and the coffee button simply does not render.
#
# A Stripe Payment Link, e.g. https://buy.stripe.com/xxxxxxxx
# NEXT_PUBLIC_ means this value is baked into the public page, so use a
# Payment Link URL only - never a Stripe API key.
NEXT_PUBLIC_COFFEE_URL=
